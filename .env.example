# .env.example
# Copy to .env and fill values

# NewsAPI key (optional). If empty, scraper fallback will be used.
NEWSAPI_KEY=

# Model name for sentence-transformers
MODEL_NAME=all-MiniLM-L6-v2

# Where data is stored (relative to project root)
DATA_DIR=data

# FAISS / embedding config
EMBED_BATCH=64
MAX_SCRAPE_ARTICLES_PER_SITE=20
